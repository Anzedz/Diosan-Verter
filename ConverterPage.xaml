<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Diosan_Verter.ViewModels"
             x:Class="Diosan_Verter.ConverterPage"
             x:DataType="vm:ConverterPageViewModel"
             BackgroundColor="#FFF4D6"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header takes the tile's color -->
        <Border x:Name="HeaderBorder" Grid.Row="0" StrokeThickness="0" Padding="12,40,12,16"
                BackgroundColor="{Binding ThemeColor}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,32,32" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,48">
                <Button Text="⬅" Clicked="OnBackClicked" BackgroundColor="White"
                        TextColor="Black" FontSize="20" WidthRequest="48" HeightRequest="48"
                        CornerRadius="24" Padding="0" />
                <Label Grid.Column="1" Text="{Binding Title}" FontFamily="FredokaBold"
                       FontSize="28" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="12">

                <Label Text="✏️ Type a number" FontFamily="FredokaBold" FontSize="18"
                       TextColor="#333" />
                <Border BackgroundColor="White" Stroke="#DDD" StrokeThickness="2" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Entry Placeholder="0" Keyboard="Numeric"
                           FontFamily="FredokaBold" FontSize="28" TextColor="Black"
                           PlaceholderColor="#999"
                           Text="{Binding InputValue, Mode=TwoWay}" />
                </Border>

                <Label Text="From" FontFamily="FredokaBold" FontSize="18" TextColor="#333" />
                <Border BackgroundColor="White" Stroke="#DDD" StrokeThickness="2" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Picker FontFamily="FredokaRegular" FontSize="20" TextColor="Black"
                            ItemsSource="{Binding UnitNames}"
                            SelectedIndex="{Binding FromUnitIndex, Mode=TwoWay}" />
                </Border>

                <Button Text="🔄 Swap" Command="{Binding SwapCommand}" BackgroundColor="#FFC93C"
                        TextColor="Black" FontFamily="FredokaBold" FontSize="18"
                        CornerRadius="24" HeightRequest="50" HorizontalOptions="Center"
                        WidthRequest="160" />

                <Label Text="To" FontFamily="FredokaBold" FontSize="18" TextColor="#333" />
                <Border BackgroundColor="White" Stroke="#DDD" StrokeThickness="2" Padding="12,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Picker FontFamily="FredokaRegular" FontSize="20" TextColor="Black"
                            ItemsSource="{Binding UnitNames}"
                            SelectedIndex="{Binding ToUnitIndex, Mode=TwoWay}" />
                </Border>

                <Border Padding="16" Margin="0,10,0,0"
                        BackgroundColor="{Binding ThemeColor}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🎉 Answer" FontFamily="FredokaBold" FontSize="16"
                               TextColor="White" HorizontalOptions="Center" />
                        <Label Text="{Binding Result}" FontFamily="FredokaBold"
                               FontSize="30" TextColor="White"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
